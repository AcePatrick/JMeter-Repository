            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion" enabled="false">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">// Function to clean up string for number parsing
def cleanNumber = { val -&gt;
    return val?.replaceAll(/[$\s\u00A0]/, &apos;&apos;) // remove dollar signs, spaces, non-breaking spaces
}

// Fetch variables from JMeter and clean values
// Fetch data from website
def actualWorkingItemID = vars.get(&quot;actualWorkingItemID&quot;)
def actualDescription = vars.get(&quot;actualDescription&quot;)
def actualQuantity = vars.get(&quot;actualQuantity&quot;)
def actualPrice = cleanNumber(vars.get(&quot;actualPrice&quot;))
def actualTotalCost = cleanNumber(vars.get(&quot;actualTotalCost&quot;))

// Fetch data from csv file
def expectedWorkingItemID = vars.get(&quot;ExpectedWorkingItemID&quot;)
def expectedDescription = vars.get(&quot;ExpectedDescription&quot;)
def expectedQuantity = vars.get(&quot;ExpectedQuantity&quot;)
def expectedPrice = cleanNumber(vars.get(&quot;ExpectedPrice&quot;))
def expectedTotalCost = cleanNumber(vars.get(&quot;ExpectedTotalCost&quot;))

// Array for messages
def errors = []

// Counter for assertion
def assertionFailedCounter = 0
def assertionPassedCounter = 0
def assertionTotalCounter = 0

// Convert to BigDecimal safely
try {
    def actualPriceNum = new BigDecimal(actualPrice)
    def expectedPriceNum = new BigDecimal(expectedPrice)
    def actualTotalCostNum = new BigDecimal(actualTotalCost)
    def expectedTotalCostNum = new BigDecimal(expectedTotalCost)

    // Conditional Statements for assertions
    if (actualWorkingItemID != expectedWorkingItemID) {
        errors &lt;&lt; &quot;❌ mismatch: Expected=${expectedWorkingItemID}, Actual=${actualWorkingItemID}&quot;
        assertionFailedCounter += 1
    } else {
    	   assertionPassedCounter += 1
    }
    assertionTotalCounter += 1

    if (actualDescription != expectedDescription) {
        errors &lt;&lt; &quot;❌ mismatch: Expected=${expectedDescription}, Actual=${actualDescription}&quot;
        assertionFailedCounter += 1
    } else {
        assertionPassedCounter += 1
    }
    assertionTotalCounter += 1

    if (actualQuantity != expectedQuantity) {
        errors &lt;&lt; &quot;❌ mismatch: Expected=${expectedQuantity}, Actual=${actualQuantity}&quot;
        assertionFailedCounter += 1
    } else {
        assertionPassedCounter += 1
    }
    assertionTotalCounter += 1

    if (actualPriceNum != expectedPriceNum) {
        errors &lt;&lt; &quot;❌ mismatch: Expected=${expectedPriceNum}, Actual=${actualPriceNum}&quot;
        assertionFailedCounter += 1
    } else {
    	   assertionPassedCounter += 1
    }
    assertionTotalCounter += 1

    if (actualTotalCostNum != expectedTotalCostNum) {
        errors &lt;&lt; &quot;❌ mismatch: Expected=${expectedTotalCostNum}, Actual=${actualTotalCostNum}&quot;
        assertionFailedCounter += 1
    } else {
        assertionPassedCounter += 1
    }
    assertionTotalCounter += 1

    // Conditional Statements for logs
    if (errors) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(errors.join(&apos;\n&apos;))
        log.info(&quot;\n❌ Assertion failed! Failed:(${assertionFailedCounter}/${assertionTotalCounter}) Passed:(${assertionPassedCounter}/${assertionTotalCounter})&quot;)
    } else {
        log.info(&quot;\n✅ Assertion passed! (${assertionPassedCounter}/${assertionTotalCounter})&quot;)

    }
    // Logs for expected and actual data
    log.info(&quot;Working Item ID: Expected: ${expectedWorkingItemID} | Actual: ${actualWorkingItemID}&quot;)
    log.info(&quot;Description: Expected: ${expectedDescription} | Actual: ${actualDescription}&quot;)
    log.info(&quot;Quantity: Expected: ${expectedQuantity} | Actual: ${actualQuantity}&quot;)
    log.info(&quot;Price: Expected: ${expectedPriceNum} | Actual: ${actualPriceNum}&quot;)
    log.info(&quot;Total Cost: Expected: ${expectedTotalCostNum} | Actual: ${actualTotalCostNum}&quot;)

} catch (Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;❌ Number formatting error: &quot; + e.getMessage())
}</stringProp>
              <stringProp name="scriptLanguage">beanshell</stringProp>
            </JSR223Assertion>
            <hashTree/>
            <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="BeanShell Assertion">
              <stringProp name="BeanShellAssertion.query">import java.math.BigDecimal;

// ==========================
// SAFE NUMBER PARSER
// ==========================
BigDecimal safeBigDecimal(String val) {
    if (val == null) return BigDecimal.ZERO;

    val = val.replaceAll(&quot;[$,\\s\\u00A0]&quot;, &quot;&quot;).trim();

    if (val.equals(&quot;&quot;) || val.equalsIgnoreCase(&quot;null&quot;)) {
        return BigDecimal.ZERO;
    }

    try {
        return new BigDecimal(val);
    } catch (Exception e) {
        log.error(&quot;❌ Invalid number format: &quot; + val);
        return BigDecimal.ZERO;
    }
}

// ==========================
// CLEAN STRING (NON-NUMBER)
// ==========================
String cleanNumber(String val) {
    if (val == null) return &quot;&quot;;
    return val.replaceAll(&quot;[$,\\s\\u00A0]&quot;, &quot;&quot;).trim();
}

// ==========================
// GET ACTUAL VALUES
// ==========================
String actualWorkingItemID = vars.get(&quot;actualWorkingItemID&quot;);
String actualDescription   = vars.get(&quot;actualDescription&quot;);
String actualQuantity      = vars.get(&quot;actualQuantity&quot;);

String actualPrice         = vars.get(&quot;actualPrice&quot;);
String actualTotalCost     = vars.get(&quot;actualTotalCost&quot;);

// ==========================
// GET EXPECTED VALUES (CSV)
// ==========================
String expectedWorkingItemID = vars.get(&quot;ExpectedWorkingItemID&quot;);
String expectedDescription   = vars.get(&quot;ExpectedDescription&quot;);
String expectedQuantity      = vars.get(&quot;ExpectedQuantity&quot;);

String expectedPrice     = vars.get(&quot;ExpectedPrice&quot;);
String expectedTotalCost = vars.get(&quot;ExpectedTotalCost&quot;);

// ==========================
// INIT CONTAINERS
// ==========================
StringBuilder mismatches = new StringBuilder();
StringBuilder matches = new StringBuilder();

int failed = 0;
int passed = 0;
int total = 0;

// ==========================
// SAFE NUMBERS
// ==========================
BigDecimal actualPriceNum = safeBigDecimal(actualPrice);
BigDecimal expectedPriceNum = safeBigDecimal(expectedPrice);

BigDecimal actualTotalCostNum = safeBigDecimal(actualTotalCost);
BigDecimal expectedTotalCostNum = safeBigDecimal(expectedTotalCost);

// ==========================
// ASSERTIONS
// ==========================

// Working Item ID
total++;
if (actualWorkingItemID == null || !actualWorkingItemID.equals(expectedWorkingItemID)) {
    mismatches.append(&quot;❌ Working Item ID: Expected: &quot;)
              .append(expectedWorkingItemID)
              .append(&quot; | Actual: &quot;)
              .append(actualWorkingItemID)
              .append(&quot;\n&quot;);
    failed++;
} else {
    matches.append(&quot;✔ Working Item ID: Expected: &quot;)
           .append(expectedWorkingItemID)
           .append(&quot; | Actual: &quot;)
           .append(actualWorkingItemID)
           .append(&quot;\n&quot;);
    passed++;
}

// Description
total++;
if (actualDescription == null || !actualDescription.equals(expectedDescription)) {
    mismatches.append(&quot;❌ Description: Expected: &quot;)
              .append(expectedDescription)
              .append(&quot; | Actual: &quot;)
              .append(actualDescription)
              .append(&quot;\n&quot;);
    failed++;
} else {
    matches.append(&quot;✔ Description: Expected: &quot;)
           .append(expectedDescription)
           .append(&quot; | Actual: &quot;)
           .append(actualDescription)
           .append(&quot;\n&quot;);
    passed++;
}

// Quantity
total++;
if (actualQuantity == null || !actualQuantity.equals(expectedQuantity)) {
    mismatches.append(&quot;❌ Quantity: Expected: &quot;)
              .append(expectedQuantity)
              .append(&quot; | Actual: &quot;)
              .append(actualQuantity)
              .append(&quot;\n&quot;);
    failed++;
} else {
    matches.append(&quot;✔ Quantity: Expected: &quot;)
           .append(expectedQuantity)
           .append(&quot; | Actual: &quot;)
           .append(actualQuantity)
           .append(&quot;\n&quot;);
    passed++;
}

// Price
total++;
if (actualPriceNum.compareTo(expectedPriceNum) != 0) {
    mismatches.append(&quot;❌ Price: Expected: &quot;)
              .append(expectedPriceNum)
              .append(&quot; | Actual: &quot;)
              .append(actualPriceNum)
              .append(&quot;\n&quot;);
    failed++;
} else {
    matches.append(&quot;✔ Price: Expected: &quot;)
           .append(expectedPriceNum)
           .append(&quot; | Actual: &quot;)
           .append(actualPriceNum)
           .append(&quot;\n&quot;);
    passed++;
}

// Total Cost
total++;
if (actualTotalCostNum.compareTo(expectedTotalCostNum) != 0) {
    mismatches.append(&quot;❌ Total Cost: Expected: &quot;)
              .append(expectedTotalCostNum)
              .append(&quot; | Actual: &quot;)
              .append(actualTotalCostNum)
              .append(&quot;\n&quot;);
    failed++;
} else {
    matches.append(&quot;✔ Total Cost: Expected: &quot;)
           .append(expectedTotalCostNum)
           .append(&quot; | Actual: &quot;)
           .append(actualTotalCostNum)
           .append(&quot;\n&quot;);
    passed++;
}

// ==========================
// FINAL RESULT
// ==========================
String summary =
    &quot;Assertion &quot; + (failed &gt; 0 ? &quot;FAILED&quot; : &quot;PASSED&quot;) +
    &quot;! Failed:(&quot; + failed + &quot;/&quot; + total + &quot;) Passed:(&quot; + passed + &quot;/&quot; + total + &quot;)\n&quot;;

String fullLog = summary + mismatches.toString() + matches.toString();

if (failed &gt; 0) {
    failure = true;
    failureMessage = fullLog;
    Failure = true;
    FailureMessage = fullLog;
    log.error(fullLog);
} else {
    log.info(fullLog);
}</stringProp>
